# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 浏览器访问的 origin，用于双人片单写请求的同源校验；反向代理时填写真实 HTTPS 域名。
SITE_ORIGIN=http://localhost:8080
# Docker 使用持久卷保存片单数据库，非 Docker 部署默认 ./data。
# LIBRARY_DATA_DIR=/app/data
# 可选：阿里云盘扫码连接。设置独立的 32 字节随机密钥（64 位十六进制）。
# 授权信息加密保存在 LIBRARY_DATA_DIR/cloud-credentials.enc；备份时一并保存此密钥。
# CLOUD_ENCRYPTION_KEY=

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 可选：固定自行构建的 WAJJTV 镜像；默认通过 docker compose up -d --build 构建。
# WAJJTV_IMAGE=wajjtv:local
